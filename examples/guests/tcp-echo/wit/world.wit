package polyengine:tcp-echo;

/// End-to-end loopback exerciser for the REAL `wasi:sockets@0.3.0` TCP
/// surface (wit/deps vendored verbatim from upstream — the same revision
/// the iroh/wosh consumer family links). Driven by
/// wasi/tests/integration_sockets_test.ts against the à la carte
/// sockets provider: the client half is the wosh listener's exact shape
/// (create/connect/send-stream/receive-stream), and the server half runs
/// listen/accept through contracts/embedder-api.md §"Streams and futures"'s
/// resource-element streams —
/// including the guest dropping the accept stream, which must close the
/// provider's OS listener through the producer-cancellation hook.
world tcp-echo {
  import wasi:sockets/types@0.3.0;

  /// Dial 127.0.0.1:`port`, stream `payload` out (then FIN), drain and
  /// return the response.
  export echo-client: async func(port: u16, payload: list<u8>) -> list<u8>;

  /// Bind 127.0.0.1:0 and listen; returns the ephemeral port plus a
  /// completion future. A spawned task serves `conns` connections
  /// (read-to-FIN, echo back, FIN), then drops the accept stream and the
  /// listener socket, and finally resolves the future with the total
  /// bytes echoed.
  export start-echo-server: async func(conns: u32) -> tuple<u16, future<u32>>;
}
