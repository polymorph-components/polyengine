;; Regression fixture for call-owned completion and origin-aware scheduler
;; failure routing (#350/#357). Kept as source beside the generated wasm.
(component
  (component $C
    (import "host-call" (func $host-call async (result u32)))
    (core module $Mem (memory (export "mem") 1))
    (core instance $mem (instantiate $Mem))
    (type $FT (future u8))
    (core func $waitable.join (canon waitable.join))
    (core func $set.new (canon waitable-set.new))
    (core func $future.new (canon future.new $FT))
    (core func $future.read (canon future.read $FT async (memory $mem "mem")))
    (core func $future.write (canon future.write $FT async (memory $mem "mem")))
    (core func $subtask.drop (canon subtask.drop))
    (core func $ret-next (canon task.return (result u32) (memory $mem "mem")))
    (core func $ret-void (canon task.return (memory $mem "mem")))
    (core func $host-call' (canon lower (func $host-call) async (memory $mem "mem")))
    (core module $M
      (import "" "mem" (memory 1))
      (import "" "waitable.join" (func $join (param i32 i32)))
      (import "" "set.new" (func $set.new (result i32)))
      (import "" "future.new" (func $future.new (result i64)))
      (import "" "future.read" (func $future.read (param i32 i32) (result i32)))
      (import "" "future.write" (func $future.write (param i32 i32) (result i32)))
      (import "" "subtask.drop" (func $subtask.drop (param i32)))
      (import "" "ret-next" (func $ret-next (param i32)))
      (import "" "ret-void" (func $ret-void))
      (import "" "host-call" (func $host-call (param i32) (result i32)))
      (global $rx (mut i32) (i32.const 0))
      (global $tx (mut i32) (i32.const 0))
      (global $bad (mut i32) (i32.const 0))
      (func (export "next") (result i32)
        (local $ends i64) (local $ws i32)
        (local.set $ends (call $future.new))
        (global.set $rx (i32.wrap_i64 (local.get $ends)))
        (global.set $tx (i32.wrap_i64 (i64.shr_u (local.get $ends) (i64.const 32))))
        (if (i32.ne (call $future.read (global.get $rx) (i32.const 8)) (i32.const -1)) (then unreachable))
        (local.set $ws (call $set.new))
        (call $join (global.get $rx) (local.get $ws))
        (i32.or (i32.const 2) (i32.shl (local.get $ws) (i32.const 4))))
      (func (export "next-cb") (param $code i32) (param $index i32) (param $payload i32) (result i32)
        (if (i32.ne (local.get $code) (i32.const 4)) (then unreachable))
        (if (global.get $bad) (then unreachable))
        (call $ret-next (i32.load8_u (i32.const 8)))
        (i32.const 0))
      (func $do-push (param $v i32)
        (i32.store8 (i32.const 16) (local.get $v))
        (if (i32.ne (call $future.write (global.get $tx) (i32.const 16)) (i32.const 0)) (then unreachable))
        (call $ret-void))
      (func (export "push") (param $v i32) (result i32)
        (call $do-push (local.get $v)) (i32.const 0))
      (func (export "call-host") (result i32)
        (local $packed i32) (local $ws i32)
        (local.set $packed (call $host-call (i32.const 32)))
        (if (i32.eq (i32.and (local.get $packed) (i32.const 15)) (i32.const 2))
          (then (call $ret-next (i32.load (i32.const 32))) (return (i32.const 0))))
        (local.set $ws (call $set.new))
        (call $join (i32.shr_u (local.get $packed) (i32.const 4)) (local.get $ws))
        (i32.or (i32.const 2) (i32.shl (local.get $ws) (i32.const 4))))
      (func (export "call-host-cb") (param $code i32) (param $index i32) (param $payload i32) (result i32)
        (if (i32.ne (local.get $code) (i32.const 1)) (then unreachable))
        (if (i32.ne (local.get $payload) (i32.const 2)) (then unreachable))
        (if (global.get $bad) (then unreachable))
        (call $subtask.drop (local.get $index))
        (call $ret-next (i32.load (i32.const 32)))
        (i32.const 0))
      (func (export "void-cb") (param i32 i32 i32) (result i32) unreachable)
      (func (export "arm-bad") (global.set $bad (i32.const 1)))
      (func (export "ping") (result i32) (i32.const 42)))
    (core instance $m (instantiate $M (with "" (instance
      (export "mem" (memory $mem "mem"))
      (export "waitable.join" (func $waitable.join))
      (export "set.new" (func $set.new))
      (export "future.new" (func $future.new))
      (export "future.read" (func $future.read))
      (export "future.write" (func $future.write))
      (export "subtask.drop" (func $subtask.drop))
      (export "ret-next" (func $ret-next))
      (export "ret-void" (func $ret-void))
      (export "host-call" (func $host-call'))))))
    (func (export "next") async (result u32)
      (canon lift (core func $m "next") async (memory $mem "mem") (callback (core func $m "next-cb"))))
    (func (export "push") async (param "v" u32)
      (canon lift (core func $m "push") async (memory $mem "mem") (callback (core func $m "void-cb"))))
    (func (export "call-host") async (result u32)
      (canon lift (core func $m "call-host") async (memory $mem "mem") (callback (core func $m "call-host-cb"))))
    (func (export "arm-bad") (canon lift (core func $m "arm-bad")))
    (func (export "ping") (result u32) (canon lift (core func $m "ping"))))

  ;; A separate caller component forces a real cross-component FACT path.
  (component $A
    (import "callee" (func $callee async (result u32)))
    (core module $Mem (memory (export "mem") 1))
    (core instance $mem (instantiate $Mem))
    (core func $callee' (canon lower (func $callee) async (memory $mem "mem")))
    (core func $set.new (canon waitable-set.new))
    (core func $waitable.join (canon waitable.join))
    (core func $subtask.drop (canon subtask.drop))
    (core func $ret (canon task.return (result u32) (memory $mem "mem")))
    (core module $M
      (import "" "mem" (memory 1))
      (import "" "callee" (func $callee (param i32) (result i32)))
      (import "" "set.new" (func $set.new (result i32)))
      (import "" "waitable.join" (func $join (param i32 i32)))
      (import "" "subtask.drop" (func $drop (param i32)))
      (import "" "ret" (func $ret (param i32)))
      (func (export "run") (result i32)
        (local $packed i32) (local $ws i32)
        (local.set $packed (call $callee (i32.const 0)))
        (local.set $ws (call $set.new))
        (call $join (i32.shr_u (local.get $packed) (i32.const 4)) (local.get $ws))
        (i32.or (i32.const 2) (i32.shl (local.get $ws) (i32.const 4))))
      (func (export "run-cb") (param $code i32) (param $index i32) (param $payload i32) (result i32)
        (if (i32.ne (local.get $code) (i32.const 1)) (then unreachable))
        (if (i32.ne (local.get $payload) (i32.const 2)) (then unreachable))
        (call $drop (local.get $index))
        (call $ret (i32.load (i32.const 0)))
        (i32.const 0)))
    (core instance $m (instantiate $M (with "" (instance
      (export "mem" (memory $mem "mem"))
      (export "callee" (func $callee'))
      (export "set.new" (func $set.new))
      (export "waitable.join" (func $waitable.join))
      (export "subtask.drop" (func $subtask.drop))
      (export "ret" (func $ret))))))
    (func (export "run") async (result u32)
      (canon lift (core func $m "run") async (memory $mem "mem") (callback (core func $m "run-cb")))))
  (import "host-x" (func $hx async (result u32)))
  (import "host-y" (func $hy async (result u32)))
  (instance $x (instantiate $C (with "host-call" (func $hx))))
  (instance $y (instantiate $C (with "host-call" (func $hy))))
  (instance $a (instantiate $A (with "callee" (func $x "call-host"))))
  (export "a-call-x" (func $a "run"))
  (export "x-next" (func $x "next"))
  (export "x-push" (func $x "push"))
  (export "x-call-host" (func $x "call-host"))
  (export "x-arm-bad" (func $x "arm-bad"))
  (export "x-ping" (func $x "ping"))
  (export "y-next" (func $y "next"))
  (export "y-push" (func $y "push"))
  (export "y-call-host" (func $y "call-host"))
  (export "y-arm-bad" (func $y "arm-bad"))
  (export "y-ping" (func $y "ping")))
